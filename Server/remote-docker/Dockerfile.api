# Noban API server — model-free, CPU only. Enqueues wake-jobs to Redis.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-server.txt .
RUN pip install --no-cache-dir -r requirements-server.txt redis

COPY . .
RUN mkdir -p /app/uploads

EXPOSE 5000
# WORKERS uvicorn processes; all share state via Redis + Postgres.
CMD ["sh", "-c", "uvicorn app_async:app --host 0.0.0.0 --port 5000 --workers ${WORKERS:-4}"]
