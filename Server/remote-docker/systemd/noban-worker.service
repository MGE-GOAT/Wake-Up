[Unit]
Description=Noban GPU wake-worker (whisper + LLM; drains Redis wake:jobs)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
WorkingDirectory=/home/mahrad/storage/Data/Server
ExecStart=/usr/bin/env bash /home/mahrad/storage/Data/Server/local-lan/run_worker.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
