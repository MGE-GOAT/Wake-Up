[Unit]
Description=Elderly-care CSI camera to v4l2loopback feeder
After=systemd-modules-load.service
# StartLimitIntervalSec belongs in [Unit] (systemd ignores it in [Service] and
# warns); 0 disables start rate-limiting so boot-time camera retries can't trip it.
StartLimitIntervalSec=0
[Service]
User=pi
ExecStart=/home/pi/device_bundle/Noban/run_camera.sh
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
